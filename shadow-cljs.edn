{:deps {:aliases [:cljs]}
 :builds
 {:app  {:target     :browser
         :output-dir "resources/public/js"
         :asset-path "/js"
         :modules    {:main {:init-fn notebook.core/init}}
         :devtools   {:after-load notebook.core/after-load}
         :release    {:compiler-options {:optimizations :advanced}}}
  :test {:target    :node-test
         :output-to "target/cljs-test/test.js"
         :ns-regexp "-test$"
         :autorun   true}}}
