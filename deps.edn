{:paths ["src/clj" "src/cljc" "resources"]
 :deps {org.clojure/clojure               {:mvn/version "1.12.0"}
        ring/ring-core                    {:mvn/version "1.15.6"}
        ring/ring-jetty-adapter           {:mvn/version "1.15.6"}
        metosin/reitit-ring               {:mvn/version "0.11.0"}
        metosin/reitit-middleware         {:mvn/version "0.11.0"}
        metosin/muuntaja                  {:mvn/version "0.6.12"}
        metosin/jsonista                  {:mvn/version "1.0.1"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        org.xerial/sqlite-jdbc            {:mvn/version "3.49.1.0"}
        clj-commons/clj-yaml              {:mvn/version "1.0.30"}
        com.nextjournal/beholder          {:mvn/version "1.0.3"}
        integrant/integrant               {:mvn/version "1.0.1"}
        org.clojure/tools.logging         {:mvn/version "1.3.0"}
        org.slf4j/slf4j-simple            {:mvn/version "2.0.16"}}
 :aliases
 {:dev   {:extra-paths ["dev" "test/clj"]
          :extra-deps  {integrant/repl {:mvn/version "0.4.0"}}}
  :run   {:main-opts ["-m" "notebook.main"]}
  :test  {:extra-paths ["test/clj"]
          :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
          :main-opts   ["-m" "kaocha.runner"]}
  :cljs  {:extra-paths ["src/cljs" "test/cljs"]
          :extra-deps  {thheller/shadow-cljs     {:mvn/version "3.5.14"}
                        reagent/reagent          {:mvn/version "1.3.0"}
                        re-frame/re-frame        {:mvn/version "1.4.7"}
                        metosin/reitit-frontend  {:mvn/version "0.11.0"}}}
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
